{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Unofficial mirror metadata",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "service",
    "official",
    "contract_version",
    "code_revision",
    "ready",
    "active_release"
  ],
  "properties": {
    "service": {
      "const": "soil-data-access"
    },
    "official": {
      "const": false
    },
    "contract_version": {
      "type": "string",
      "minLength": 1
    },
    "code_revision": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "ready": {
      "type": "boolean"
    },
    "active_release": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "datasets"
          ],
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1
            },
            "datasets": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "dataset",
                  "release_id",
                  "scope",
                  "source_url",
                  "sha256"
                ],
                "properties": {
                  "dataset": {
                    "enum": [
                      "SSURGO",
                      "STATSGO2"
                    ]
                  },
                  "release_id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "scope": {
                    "type": "string",
                    "minLength": 1
                  },
                  "source_url": {
                    "type": "string",
                    "format": "uri"
                  },
                  "sha256": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                  }
                }
              }
            }
          }
        }
      ]
    }
  },
  "if": {
    "properties": {
      "ready": {
        "const": true
      }
    }
  },
  "then": {
    "properties": {
      "active_release": {
        "type": "object"
      }
    }
  }
}
